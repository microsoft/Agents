{
  "name": "teams-sample-sync",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc --project tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && tsx --test tests/**/*.test.ts",
    "test:sdk-smoke": "node --import tsx --test tests/integration/sdk-smoke.test.ts"
  },
  "dependencies": {
    "@github/copilot-sdk": "1.0.7",
    "ajv": "8.20.0",
    "fast-xml-parser": "5.11.1",
    "minimatch": "10.2.6",
    "yaml": "2.9.0"
  },
  "overrides": {
    "@github/copilot": "1.0.83"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "tsx": "4.20.5",
    "typescript": "^7.0.2"
  }
}
