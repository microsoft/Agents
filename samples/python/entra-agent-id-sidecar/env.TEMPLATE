# Agent Identity Blueprint credential used only by the sidecar
BLUEPRINT_TENANT_ID=tenant-id
BLUEPRINT_CLIENT_ID=blueprint-application-client-id
BLUEPRINT_CLIENT_SECRET=blueprint-client-secret

# Per-instance Agent Identity application/client ID
AGENT_IDENTITY_CLIENT_ID=agent-identity-client-id

# Agents SDK connection used for inbound validation and outbound callbacks.
# Set CLIENTID and TENANTID to the same Blueprint values defined above.
# The Blueprint secret is intentionally not passed to the agent container.
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=EntraAuthSideCar
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__ANONYMOUS_ALLOWED=false
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=blueprint-application-client-id
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=tenant-id
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SIDECAR_BASE_URL=http://localhost:5000
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SERVICE_NAME=botframework
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__BLUEPRINT_SERVICE_NAME=agenticblueprint
CONNECTIONS__SERVICE_CONNECTION__SETTINGS__SCOPES=5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default
CONNECTIONSMAP__0__SERVICEURL=*
CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION
