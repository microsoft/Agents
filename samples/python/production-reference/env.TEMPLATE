# Copy to .env for local development. Shell values override this file.
# An explicit APP_ENV=production in the shell skips .env loading.
APP_ENV=development
PORT=3978
Storage__ConnectionString=UseDevelopmentStorage=true
Storage__Container=agents-production-reference-state
# Azure production uses APP_ENV=production and no secrets:
# Storage__ServiceUrl=https://<account>.blob.core.windows.net
# APPLICATIONINSIGHTS_CONNECTION_STRING=<deployment output>

# Production security policy. These values match the bounded Web Chat profile;
# omitted values use the same defaults. Audience defaults to CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID.
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTID=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__TENANTID=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__CLIENTSECRET=
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__AUTHTYPE=UserManagedIdentity
# CONNECTIONS__SERVICE_CONNECTION__SETTINGS__VALIDATE_ISSUER=true
# CONNECTIONSMAP__0__CONNECTION=SERVICE_CONNECTION
# CONNECTIONSMAP__0__SERVICEURL=*
# CONNECTIONSMAP__0__AUDIENCE=<agent-managed-identity-client-id>
# OutboundHostValidator__Enabled=true
# OutboundHostValidator__IncludeDefaultMicrosoftHosts=false
# OutboundHostValidator__Hosts=webchat.botframework.com
OTEL_SERVICE_NAME=agents-sdk-production-reference-python
# Only the sample's reviewed application spans and metrics are exported.
