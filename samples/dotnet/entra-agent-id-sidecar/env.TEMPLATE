# Copy this file to .env and replace every placeholder. Never commit .env.

# Agent Identity application (client) ID. This is the child Agent Identity,
# not the Blueprint client ID and not either service principal object ID.
AGENT_IDENTITY_CLIENT_ID=<agent-identity-client-id>

# Blueprint application values used by the sidecar to perform token exchange.
BLUEPRINT_TENANT_ID=<tenant-id>
BLUEPRINT_CLIENT_ID=<blueprint-application-client-id>
BLUEPRINT_CLIENT_SECRET=<local-development-secret>
