# Copy this file to .env. Never commit .env.

# Microsoft Entra tenant containing the Blueprint and Agent Identity.
BLUEPRINT_TENANT_ID=

# Application (client) ID of the Agent Identity Blueprint.
BLUEPRINT_CLIENT_ID=

# Local development only: a client secret created on the Blueprint.
BLUEPRINT_CLIENT_SECRET=

# Application (client) ID of the child Agent Identity service principal.
AGENT_IDENTITY_CLIENT_ID=

# Agents SDK connection used for inbound validation and outbound callbacks.
# The Blueprint secret is intentionally not passed to the agent container.
PORT=3978
NODE_ENV=development
Connections__ServiceConnection__Settings__AuthType=EntraAuthSideCar
Connections__ServiceConnection__Settings__ClientId=
Connections__ServiceConnection__Settings__TenantId=
Connections__ServiceConnection__Settings__SidecarBaseUrl=http://localhost:5000
Connections__ServiceConnection__Settings__ServiceName=botframework
Connections__ServiceConnection__Settings__BlueprintServiceName=agenticblueprint
Connections__ServiceConnection__Settings__Scopes=5a807f24-c9de-44ee-a3a7-329e88a00ffc/.default
ConnectionsMap__0__ServiceUrl=*
ConnectionsMap__0__Connection=ServiceConnection
