# Copy to .env for Azurite. Never commit .env files.
NODE_ENV=development
PORT=3978

# Azurite local state
BLOB_CONTAINER_ID=agents-production-reference-state
BLOB_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Azure App Service state. Required instead of BLOB_STORAGE_CONNECTION_STRING in production.
# BLOB_CONTAINER_URL=https://<storage-account>.blob.core.windows.net/<container>

# Production authentication. Bicep sets these values in App Service.
# Local Agents Playground use does not need them.
# connections__serviceConnection__settings__clientId=<agent-managed-identity-client-id>
# connections__serviceConnection__settings__tenantId=<tenant-id>
# connections__serviceConnection__settings__authType=UserManagedIdentity
# connections__serviceConnection__settings__validateIssuer=true
# connectionsMap__0__connection=serviceConnection
# connectionsMap__0__serviceUrl=*
# connectionsMap__0__audience=<agent-managed-identity-client-id>
# OutboundHostValidator__Enabled=true
# OutboundHostValidator__IncludeDefaultMicrosoftHosts=false
# OutboundHostValidator__Hosts=webchat.botframework.com

# Observability. App Service receives these values from Bicep.
# APPLICATIONINSIGHTS_CONNECTION_STRING=
OTEL_SERVICE_NAME=agents-sdk-production-reference
# Optional comma-separated or whitespace-separated categories: STORAGE, AUTHENTICATION, AUTHORIZATION, DIALOGS.
# AGENTS_TELEMETRY_DISABLED_SPAN_CATEGORIES=
