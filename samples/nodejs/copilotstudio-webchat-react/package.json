{
  "name": "copilotstudio-webchat-react",
  "version": "0.1.0",
  "private": true,
  "author": "Microsoft",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "apphost"
  ],
  "scripts": {
    "prebuild": "node scripts/ensure-settings.js",
    "build": "esbuild src/index.tsx --bundle --platform=browser --target=esnext --outdir=public/dist --jsx=automatic",
    "start": "npm run build -- --watch=forever --serve=localhost:3000 --servedir=./public",
    "aspire": "aspire run"
  },
  "dependencies": {
    "@azure/msal-browser": "5.27.0",
    "@microsoft/agents-copilotstudio-client": "1.9.1",
    "@opentelemetry/api": "1.10.0",
    "@opentelemetry/context-zone": "3.0.0",
    "@opentelemetry/exporter-trace-otlp-proto": "0.300.0",
    "@opentelemetry/instrumentation": "0.300.0",
    "@opentelemetry/instrumentation-document-load": "0.69.0",
    "@opentelemetry/instrumentation-fetch": "0.300.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-trace-base": "2.12.0",
    "@opentelemetry/sdk-trace-web": "2.12.0",
    "@opentelemetry/semantic-conventions": "1.44.0",
    "botframework-webchat": "4.19.2",
    "botframework-webchat-fluent-theme": "4.19.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@microsoft/aspire-cli": "13.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "^0.28.2"
  }
}
